# 原型默认无需后端；可选 Airwallex 本地沙盒服务见下方配置。
NEXT_TELEMETRY_DISABLED=1

# Copy the Airwallex settings to .env.airwallex.local (gitignored).
# Only the local sandbox server reads these values; never use NEXT_PUBLIC_ for secrets.
AIRWALLEX_CLIENT_ID=-SKsRMNmQMmVW92h7Du0Ow
AIRWALLEX_API_KEY=
AIRWALLEX_LEGAL_ENTITY_ID=le_KD4_aWnoPxOWAoHDucwRGg
AIRWALLEX_PRICE_YEAR=pri_sgpvxj9q6hncetv8e7k
AIRWALLEX_PRICE_MONTH=pri_sgpv4vrlshncesbtjk6
AIRWALLEX_LINKED_PAYMENT_ACCOUNT_ID=
# Required: publicly reachable HTTPS pages owned by your project.
AIRWALLEX_SUCCESS_URL=
AIRWALLEX_BACK_URL=
AIRWALLEX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Render automatically provides PORT and RENDER_EXTERNAL_HOSTNAME.
# AIRWALLEX_ALLOWED_HOSTS=checkout.example.com
# AIRWALLEX_HOST=0.0.0.0
AIRWALLEX_PORT=3101
# Optional frontend override; defaults to http://127.0.0.1:3101/api/airwallex/checkouts
# Local default: http://127.0.0.1:3101/api/airwallex/checkouts
# Hosted example: https://your-service.onrender.com/api/airwallex/checkouts
# NEXT_PUBLIC_AIRWALLEX_CHECKOUT_API=

# One-off Credits price: $9.99 per 1000 Credits (lot.size=1000)
AIRWALLEX_PRICE_CREDITS=pri_sgpv4vrlshncgozq53w
