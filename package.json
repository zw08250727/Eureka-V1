{
  "name": "eureka",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "node scripts/prepare-prototype.mjs && next dev",
    "build": "node scripts/prepare-prototype.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint . && node scripts/check-prototype.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/test-models.mjs",
    "test:e2e": "playwright test --pass-with-no-tests",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "typescript": "^5"
  }
}
